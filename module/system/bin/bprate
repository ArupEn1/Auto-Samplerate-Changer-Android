#!/system/bin/sh
# bprate [state|status|<rate>|auto on|off|boot on|off|drc on|off|pause on|off|<seconds>|fast on|off|jack on|off|extended on|off|profiles on|off|profile [usb|jack|other [<mode> [<bits>]|clear]]|mode <name>|bits <16|24|32|float>|reset] [force]
MODDIR=/data/adb/modules/usb_dac_bitperfect
STATE=/data/adb/usb_dac_bitperfect
. "$MODDIR/common.sh"
[ "$(id -u)" = 0 ] || { echo "Run as root: su -c 'bprate 96000'"; exit 1; }
onoff() { [ -f "$STATE/$1" ] && echo ON || echo OFF; }
case "$1" in
  state)   # machine-readable, used by the WebUI
    echo "rate=$(cat $STATE/rate 2>/dev/null)"; echo "bits=$(sr_bits)"; echo "mode=$(sr_flags | sed 's/^--//')"
    for k in boot_apply auto drc pause fast jack extended profiles; do [ -f "$STATE/$k" ] && echo "$k=1" || echo "$k=0"; done
    for o in usb jack other; do echo "prof_$o=$(prof_get $o)"; done
    echo "pause_delay=$(pause_delay)"
    unlocker_present && echo "unlocker=1" || echo "unlocker=0"
    [ -f "$STATE/lock_seen" ] && echo "lockseen=1" || echo "lockseen=0"
    exit 0 ;;
  ""|status)
    echo "Mixer rate setting: $(cat $STATE/rate 2>/dev/null) Hz, $(sr_bits)-bit, mode $(sr_flags)"
    echo "Apply at boot: $(onoff boot_apply) | Auto-follow: $(onoff auto) | DRC (compression, not bit-perfect): $(onoff drc)"
    echo "Pause around rate switches: $(onoff pause) ($(pause_delay) s) | Fast detection: $(onoff fast)"
    echo "Extended jack rates (352.8/384 kHz): $(onoff extended)"
    echo "Per-output profiles: $(onoff profiles)$(profiles_on && echo " (usb=$(prof_get usb) jack=$(prof_get jack) other=$(prof_get other))")"
    echo "Generated policy mounted: $(grep -c audio_policy /proc/mounts) mount(s) mention audio_policy"
    exit 0 ;;
  auto)
    case "$2" in
      on)  touch "$STATE/auto"; nohup "$MODDIR/system/bin/bpfollow" >/dev/null 2>&1 &
           echo "Auto-follow ON (log: $STATE/follow.log)"; exit 0 ;;
      off) rm -f "$STATE/auto"; echo "Auto-follow OFF"; exit 0 ;;
      *)   echo "Usage: bprate auto on|off"; exit 1 ;;
    esac ;;
  boot)
    case "$2" in on) touch "$STATE/boot_apply"; echo "Will apply at every boot" ;; off) rm -f "$STATE/boot_apply"; echo "Will not apply at boot" ;; *) echo "Usage: bprate boot on|off"; exit 1 ;; esac
    exit 0 ;;
  mode)
    case "$2" in
      offload|offload-hifi-playback|offload-direct|offload-safer|bypass-offload|bypass-offload-safer|legacy|safe|safest|safest-auto|usb-only)
        echo "--$2" > "$STATE/sr_flags"; R=$(cat "$STATE/rate"); echo "Mode set to --$2"
        profiles_on && echo "Note: per-output profiles are ON, so the profile of the current output will switch it back. Change it with: bprate profile <usb|jack|other> $2" ;;
      *) echo "Usage: bprate mode bypass-offload-safer|bypass-offload|usb-only|offload-hifi-playback|offload|offload-safer|offload-direct|legacy|safe|safest|safest-auto"; exit 1 ;;
    esac ;;
  drc)
    case "$2" in on) touch "$STATE/drc"; R=$(cat "$STATE/rate"); echo "DRC ON (louder, compressed; not bit-perfect)" ;; off) rm -f "$STATE/drc"; R=$(cat "$STATE/rate"); echo "DRC OFF (default)" ;; *) echo "Usage: bprate drc on|off"; exit 1 ;; esac ;;
  pause)
    case "$2" in
      on)  touch "$STATE/pause"; echo "Pause/resume around rate switches ON ($(pause_delay) s)"; exit 0 ;;
      off) rm -f "$STATE/pause"; echo "Pause/resume around rate switches OFF"; exit 0 ;;
      [0-9]|[0-9].[0-9]|[0-9].[0-9][0-9]) echo "$2" > "$STATE/pause_delay"; touch "$STATE/pause"; echo "Pause delay set to $2 s (pause/resume ON)"; exit 0 ;;
      *)   echo "Usage: bprate pause on|off|<seconds, e.g. 1.5>"; exit 1 ;;
    esac ;;
  jack)
    case "$2" in
      on)  touch "$STATE/jack"; echo "Jack following ON (experimental): the 3.5 mm jack counts as an output. Use a mode that changes the jack rate, e.g. bypass-offload."; exit 0 ;;
      off) rm -f "$STATE/jack"; echo "Jack following OFF (USB only)"; exit 0 ;;
      *)   echo "Usage: bprate jack on|off"; exit 1 ;;
    esac ;;
  profiles)
    case "$2" in
      on)  touch "$STATE/profiles"; echo "Per-output profiles ON (experimental). Outputs without a profile keep the current mode. Set one with: bprate profile usb|jack|other <mode> [bits]"; [ -f "$STATE/auto" ] || echo "Note: profiles are applied by the follower, so turn on Auto-follow too: bprate auto on"; exit 0 ;;
      off) rm -f "$STATE/profiles"; echo "Per-output profiles OFF (the mode now in effect stays until you change it)"; exit 0 ;;
      *)   echo "Usage: bprate profiles on|off"; exit 1 ;;
    esac ;;
  profile)
    if [ -z "$2" ]; then
      for o in usb jack other; do p=$(prof_get $o); echo "$o: ${p:-(not set, keeps the current mode)}"; done
      echo "Profiles are $(onoff profiles). Output now: $(out_kind)"; exit 0
    fi
    valid_out "$2" || { echo "Usage: bprate profile [usb|jack|other [<mode> [<bits>]|clear]]"; exit 1; }
    case "$3" in
      "") p=$(prof_get "$2"); echo "$2: ${p:-(not set, keeps the current mode)}"; exit 0 ;;
      clear) rm -f "$STATE/prof_$2"; echo "Profile '$2' cleared (that output keeps whatever mode is in effect)"; exit 0 ;;
    esac
    prof_set "$2" "$3" "$4" || { echo "Usage: bprate profile $2 <mode> [16|24|32|float]   (mode as for: bprate mode)"; exit 1; }
    echo "Profile '$2' = $(prof_get "$2")$(profiles_on || echo ". Profiles are OFF: turn them on with: bprate profiles on")"; exit 0 ;;
  extended)
    case "$2" in
      on)  touch "$STATE/extended"; echo "Extended sample rates ON for the 3.5 mm jack: it may be asked for 352.8 and 384 kHz. The jack lists no rates, so this is a trial (384 kHz worked on an LG V30+). If the jack goes silent or noisy: bprate extended off. USB DACs are not affected: they use the rates they list."; exit 0 ;;
      off) rm -f "$STATE/extended"; echo "Extended sample rates OFF: the jack is never asked for more than 192 kHz"; exit 0 ;;
      *)   echo "Usage: bprate extended on|off"; exit 1 ;;
    esac ;;
  fast)
    case "$2" in
      on)  touch "$STATE/fast"; echo "Fast detection ON (pauses sooner after a track starts; polls more often)"; exit 0 ;;
      off) rm -f "$STATE/fast"; echo "Fast detection OFF"; exit 0 ;;
      *)   echo "Usage: bprate fast on|off"; exit 1 ;;
    esac ;;
  bits)
    case "$2" in 16|24|32|float) echo "$2" > "$STATE/sr_bits"; R=$(cat "$STATE/rate"); echo "Bit depth set to $2" ;; *) echo "Usage: bprate bits 16|24|32|float"; exit 1 ;; esac ;;
  reset)
    sr_run --reset; rm -f "$STATE/boot_apply" "$STATE/auto"
    echo "Policy overlay removed and audio server restarted. Apply at boot and auto-follow are OFF."; exit 0 ;;
  44100|48000|88200|96000|176400|192000|352800|384000) R=$1 ;;
  *) echo "Usage: bprate [status|44100|48000|88200|96000|176400|192000|auto on|off|boot on|off|drc on|off|pause on|off|<seconds>|fast on|off|jack on|off|extended on|off|profiles on|off|profile ...|mode <name>|bits <n>|reset] [force]"; exit 1 ;;
esac
case "$1" in mode|bits|drc) ;; *)
  for c in /proc/asound/card*; do
    [ -f "$c/usbid" ] || continue
    if ! rate_supported "$R" "$c/stream0" && [ "$2" != "force" ]; then
      echo "DAC ($(cat $c/id)) does not list $R Hz. Add 'force' to override."; exit 1
    fi
  done ;;
esac
if apply_rate "$R"; then echo "Applied $(sr_flags) $R Hz $(sr_bits)-bit. Audio server restarted; replug the DAC if it stays silent."; else echo "Apply failed (see message above)."; exit 1; fi
